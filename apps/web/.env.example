# Copie para .env.local e preencha com os valores reais (nunca comitar .env.local).
# NEXT_PUBLIC_* são expostas ao navegador: só valores públicos/não sensíveis.

# URL do projeto Supabase (pendente de definição pelo cliente — ver docs/PRD.md, seção "Pendências")
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública) do Supabase — nunca a service_role aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=
